# Kopiera till .env och fyll i. .env checkas aldrig in.

# Port på värden som appen nås på (bakom reverse proxy med HTTPS).
PORT=8090

# Kommer senare: token för publicering till hugo-mcfrojd/husbil.
# GITHUB_TOKEN=

# S3 (Garage på Synology). Läses av pocketbase/pb_hooks/storage.pb.js vid varje
# start; tomt S3_ENDPOINT = inställningarna i admin-gränssnittet gäller.
# Testmiljön: bara media mot testbucketen, ingen S3-backup.
S3_ENDPOINT=http://100.114.28.40:3900
S3_REGION=garage
S3_MEDIA_BUCKET=vararesor-test
S3_MEDIA_ACCESS_KEY=
S3_MEDIA_SECRET=

# Produktion: media i vararesor-media och backup av databasen varje natt.
# S3_MEDIA_BUCKET=vararesor-media
# S3_BACKUP_BUCKET=vararesor-backup
# S3_BACKUP_ACCESS_KEY=
# S3_BACKUP_SECRET=
# BACKUP_CRON=0 3 * * *
# BACKUP_MAX_KEEP=14
