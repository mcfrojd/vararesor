# Kopiera till .env och fyll i. .env checkas aldrig in.
# Testmiljön (docker-compose.test.yml) läser i stället .env.test, med samma
# variabler men S3_MEDIA_BUCKET=vararesor-test, testnyckeln och ingen S3_BACKUP_*.

# Port på värden som appen nås på (bakom reverse proxy med HTTPS).
PORT=8090

# Kommer senare: token för publicering till hugo-mcfrojd/husbil.
# GITHUB_TOKEN=

# S3 (Garage på Synology). Läses av pocketbase/pb_hooks/storage.pb.js vid varje
# start; tomt S3_ENDPOINT = inställningarna i admin-gränssnittet gäller.
S3_ENDPOINT=http://100.114.28.40:3900
S3_REGION=garage

# Media: bilder och andra filer.
S3_MEDIA_BUCKET=vararesor-media
S3_MEDIA_ACCESS_KEY=
S3_MEDIA_SECRET=

# Backup av databasen varje natt.
S3_BACKUP_BUCKET=vararesor-backup
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET=
BACKUP_CRON=0 3 * * *
BACKUP_MAX_KEEP=14

# Immich på NAS:en: bildernas riktiga plats (Android tar bort GPS vid uppladdning
# från webben). Nyckel per person, skapas i Immich under Kontoinställningar →
# API-nycklar, behörighet asset.read. Format: e-post:nyckel, kommaseparerat.
# Se pocketbase/pb_hooks/immich.js.
IMMICH_URL=http://100.114.28.40:2283
IMMICH_API_KEYS=
